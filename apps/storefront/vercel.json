{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/notify.ts": {
      "includeFiles": "server/**"
    },
    "api/create-order.ts": {
      "includeFiles": "server/**"
    },
    "api/admin-orders.ts": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
